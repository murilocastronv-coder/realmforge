# RealmForge — Environment Variables
# Copy this file to .env and adjust values as needed.

# ── Server ──
REALMFORGE_HOST=0.0.0.0
REALMFORGE_PORT=8080
RUST_LOG=info

# ── Client ──
# The Vite dev server proxies /ws to the game server automatically.
# Adjust if running the server on a different host/port.
# VITE_WS_URL=ws://localhost:8080/ws
